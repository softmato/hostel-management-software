{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "installCommand": "npm install --prefix=../.. --include=dev",
  "buildCommand": "next build",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- ../.. ':(exclude)../../apps/mobile' ':(exclude)../../docs' ':(exclude)../../graphify-out' ':(exclude)../../ui_inspiration_folder' ':(exclude,glob)../../*.md'"
}
