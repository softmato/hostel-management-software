{
  "expo": {
    "name": "HostelHub",
    "slug": "hostelproject",
    "owner": "softmatotechnology",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hostelhub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.softmato.hostelhub",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "HostelHub uses the camera to scan your hostel activation QR code and to attach photos to payment claims, complaints and meals.",
        "NSLocationWhenInUseUsageDescription": "HostelHub uses your approximate location to sort hostels by how far they are from you. Your location is never saved or shared.",
        "NSPhotoLibraryUsageDescription": "HostelHub needs your photo library so you can attach payment receipts and meal photos.",
        "NSFaceIDUsageDescription": "HostelHub can use Face ID to unlock the app."
      }
    },
    "android": {
      "package": "com.softmato.hostelhub",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0a8a4b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "hostel-management-software-web.vercel.app",
              "pathPrefix": "/ref/"
            },
            {
              "scheme": "https",
              "host": "hostel-management-software-web.vercel.app",
              "path": "/inquiry"
            },
            {
              "scheme": "https",
              "host": "hostel-management-software-web.vercel.app",
              "path": "/guardian-invite"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a8a4b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0a8a4b",
          "androidMode": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow HostelHub to access your photos so you can attach payment receipts and meal photos.",
          "cameraPermission": "Allow HostelHub to use your camera to scan activation codes and take photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HostelHub to use your camera to scan your hostel activation QR code."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Allow HostelHub to use your approximate location to sort hostels by distance. It is never saved or shared."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow HostelHub to use Face ID to unlock the app."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2b0ab97-162c-425c-8f06-6e7db901e1e6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
