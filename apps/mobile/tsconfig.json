{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@hostel/calendar/*": ["../../packages/shared/src/calendar/*"],
      "@hostel/plans/*": ["../../packages/shared/src/plans/*"],
      "@hostel/food/*": ["../../packages/shared/src/food/*"],
      "@hostel/night/*": ["../../packages/shared/src/night/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts",
    "../../packages/shared/src/calendar/**/*.ts",
    "../../packages/shared/src/plans/**/*.ts",
    "../../packages/shared/src/food/**/*.ts",
    "../../packages/shared/src/night/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo", "android", "ios"]
}
